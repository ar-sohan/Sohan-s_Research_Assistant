# Copy this file to .env and pick ONE provider block.
# .env is in .gitignore, so your keys never reach GitHub.

# --- Ollama (local, free, no key) -------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# --- Groq (free tier, needs a key from console.groq.com) ---------------------
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key-here
# LLM_MODEL=llama-3.3-70b-versatile

# --- Google AI Studio / Gemini (free tier) -----------------------------------
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key-here
# LLM_MODEL=gemini-2.5-flash
